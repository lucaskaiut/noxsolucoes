# Analytics — habilite apenas os providers desejados.
# Flags aceitam "true" ou "1". Provider sem ID configurado não é registrado.

# Logs detalhados no console do navegador
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Google Analytics 4
NEXT_PUBLIC_ANALYTICS_GA4=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads (conversões por canal de contato; IDs são públicos, aparecem no HTML)
NEXT_PUBLIC_ANALYTICS_GOOGLE_ADS=false
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_EMAIL=

# Meta Pixel
NEXT_PUBLIC_ANALYTICS_META_PIXEL=false
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag
NEXT_PUBLIC_ANALYTICS_LINKEDIN=false
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID_LEAD=

# Microsoft Clarity
NEXT_PUBLIC_ANALYTICS_CLARITY=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# CMS (Blog)
CMS_API_URL=
CMS_API_TOKEN=
CMS_IMAGE_HOSTNAME=

# Token do CMS com a permissão lead.create (usado por /api/leads).
# Se vazio, usa CMS_API_TOKEN — que então precisa ter lead.create.
CMS_LEADS_TOKEN=

# Avaliações do Google (Places API New) — usado só no servidor
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
